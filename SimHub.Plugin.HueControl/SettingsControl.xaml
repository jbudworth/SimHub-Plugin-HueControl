<UserControl x:Class="SimHub.Plugin.HueControl.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="700">

    <!-- Uses SimHub's own native plugin-settings controls (SimHub.Plugins.Styles), the same
         ones the SimHub SDK demo project uses, for the section titles and buttons, so those
         follow the user's configured theme/accent colour. The Border around each section uses
         MahApps.Metro's standard "AccentColorBrush" DynamicResource key (SimHub is built on
         MahApps.Metro, confirmed via its use of MahApps.Metro.IconPacks), so the border should
         also track the accent colour. If this key doesn't resolve on your SimHub build, it'll
         quietly fall back to no visible border rather than fail to build, just let me know and
         I'll adjust it. Deliberately not defining a local fallback brush with the same key here,
         since that would shadow the real app-level one instead of falling through to it. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Philips Hue Control" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <styles:SHButtonSecondary x:Name="ExportButton" Width="70" Height="28" VerticalAlignment="Center" Click="ExportButton_Click" Margin="0,0,8,0">Export</styles:SHButtonSecondary>
                    <styles:SHButtonSecondary x:Name="ImportButton" Width="70" Height="28" VerticalAlignment="Center" Click="ImportButton_Click" Margin="0,0,8,0">Import</styles:SHButtonSecondary>
                    <styles:SHButtonPrimary x:Name="SaveButton" Height="28" VerticalAlignment="Center" Click="SaveButton_Click">Save settings</styles:SHButtonPrimary>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8"
                           Text="Pair with your Hue bridge below, load your lights, tick the ones to expose, then Save. Actions appear in Controls and Events after restarting SimHub."/>
            </Grid>

            <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                    <styles:SHSection Title="Bridge connection" ShowSeparator="True">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bridge IP" VerticalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="BridgeIpBox" Grid.Column="1" Margin="0,2,8,2" VerticalContentAlignment="Center"/>
                                <styles:SHButtonSecondary x:Name="DiscoverButton" Grid.Column="2" Height="28" Click="DiscoverButton_Click">Discover</styles:SHButtonSecondary>
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="ApiKeyBox" Grid.Column="1" Margin="0,2,8,2" VerticalContentAlignment="Center"/>
                                <styles:SHButtonSecondary x:Name="PairButton" Grid.Column="2" Height="28" Click="PairButton_Click">Pair (press bridge button first)</styles:SHButtonSecondary>
                            </Grid>

                            <TextBlock x:Name="StatusText" Foreground="OrangeRed" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </styles:SHSection>
                </Border>

                <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                    <styles:SHSection Title="Lights" ShowSeparator="True">
                        <StackPanel>
                            <styles:SHButtonSecondary x:Name="LoadLightsButton" HorizontalAlignment="Left" Height="28" Margin="0,2,0,8" Click="LoadLightsButton_Click">Load lights from bridge</styles:SHButtonSecondary>

                            <DataGrid x:Name="LightsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="60"/>
                                    <DataGridTextColumn Header="Bridge Id" Binding="{Binding Id}" Width="70" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Bridge name" Binding="{Binding BridgeName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Action name (no spaces)" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                       Text="Actions are created per light as: TurnOn.[name], TurnOff.[name], Toggle.[name], BrightnessUp.[name], BrightnessDown.[name], SetBrightness1/25/50/75/100.[name], SetColor.[name].[preset]. Restart SimHub after changing this list so new actions appear in Controls and Events."/>
                        </StackPanel>
                    </styles:SHSection>
                </Border>

                <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                    <styles:SHSection Title="Colour presets" ShowSeparator="True">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                       Text="Hex colour format: #RRGGBB, e.g. #FF0000."/>
                            <DataGrid x:Name="PresetsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                      CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Preset name" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="Hex colour" Binding="{Binding Hex}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </styles:SHSection>
                </Border>

                <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                    <styles:SHSection Title="Other settings" ShowSeparator="False">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness step (%)" VerticalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="BrightnessStepBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Poll interval (ms)" VerticalAlignment="Center" Grid.Column="0"/>
                                <TextBox x:Name="PollIntervalBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </styles:SHSection>
                </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
